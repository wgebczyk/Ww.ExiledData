<!--
  Styles for the Settings dialog. Colors only from Tokens.axaml.
  Inputs are a Border.field (or Border.stepper) holding a TextBox.bare, so the frame can show the states:
  .changed (unsaved edit: amber border), .error (danger border and tint).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Field frames -->
  <Style Selector="Border.field, Border.stepper">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.field:focus-within, Border.stepper:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Border.field.changed, Border.stepper.changed">
    <Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBrush}" />
  </Style>
  <Style Selector="Border.field.error, Border.stepper.error">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
  </Style>

  <!-- A TextBox without its own frame, inside a Border.field / Border.stepper -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource BlueTintLineBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:pointerover, TextBox.bare:focus">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBox.number">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Padding" Value="8,0,4,0" />
  </Style>

  <!-- Stepper buttons: − and + at the ends of a Border.stepper -->
  <Style Selector="Button.step">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Width" Value="38" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_Body"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Foreground="{TemplateBinding Foreground}"
                          Content="{TemplateBinding Content}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.step.small">
    <Setter Property="Width" Value="30" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="Button.step:pointerover /template/ ContentPresenter#PART_Body">
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="Button.step:disabled /template/ ContentPresenter#PART_Body">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.step:focus-visible /template/ ContentPresenter#PART_Body">
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
  </Style>

  <!-- Setting rows inside a card: label column, control column; rows separated by a line -->
  <Style Selector="Border.row">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,18" />
  </Style>
  <Style Selector="Border.row.first">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBlock.rowlabel">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.desc">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.helper">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}" />
  </Style>
  <Style Selector="TextBlock.pagetitle">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Unsaved-change dot -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource AmberAccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- "↺ Reset to 10" and similar inline links -->
  <Style Selector="Button.inline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_Body" Background="Transparent" Foreground="{TemplateBinding Foreground}"
                          Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.inline:pointerover /template/ ContentPresenter#PART_Body, Button.inline:focus-visible /template/ ContentPresenter#PART_Body">
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Button.inline.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Callouts and banners -->
  <Style Selector="Border.info">
    <Setter Property="Background" Value="{DynamicResource InfoTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InfoTintLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.info > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AmberTintLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.banner > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Category list -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected TextBlock.navlabel">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.navlabel.soon">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Border.soonchip">
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PillRadius}" />
    <Setter Property="Padding" Value="7,0" />
  </Style>
  <Style Selector="Border.soonchip > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Border.errorpill">
    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PillRadius}" />
    <Setter Property="Padding" Value="7,0" />
  </Style>
  <Style Selector="Border.errorpill > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
  </Style>

  <!-- Hotkeys: keycaps inside the recorder box -->
  <Style Selector="Border.keycap">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,1" />
  </Style>
  <Style Selector="Border.keycap > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector=":is(Border).recorder">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="MinWidth" Value="180" />
  </Style>
  <Style Selector=":is(Border).recorder:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector=":is(Border).recorder.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource AmberTintLineBrush}" />
  </Style>
  <Style Selector=":is(Border).recorder.changed">
    <Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBrush}" />
  </Style>
  <Style Selector=":is(Border).recorder.error">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
  </Style>
  <Style Selector=":is(Border).recorder.recording">
    <Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
    <Setter Property="Padding" Value="9,6" />
  </Style>

  <!-- Placement: radio rows with an amber ring -->
  <Style Selector="RadioButton.option">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Body" Background="Transparent" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Panel Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse Name="PART_Ring" Stroke="{DynamicResource LineStrongBrush}" StrokeThickness="2" />
              <Ellipse Name="PART_Dot" Width="6" Height="6" Fill="{DynamicResource AmberAccentBrush}" IsVisible="False" />
            </Panel>
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.option:pointerover /template/ Border#PART_Body">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
  </Style>
  <Style Selector="RadioButton.option:focus-visible /template/ Border#PART_Body">
    <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="RadioButton.option:checked">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.option:checked /template/ Border#PART_Body">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
  </Style>
  <Style Selector="RadioButton.option:checked /template/ Ellipse#PART_Ring">
    <Setter Property="Stroke" Value="{DynamicResource AmberAccentBrush}" />
  </Style>
  <Style Selector="RadioButton.option:checked /template/ Ellipse#PART_Dot">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- Dashed "+ Add area" -->
  <Style Selector="Button.dashed">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Body" Background="{DynamicResource PanelRaisedBrush}">
          <Rectangle Stroke="{DynamicResource LineStrongBrush}" StrokeThickness="1" StrokeDashArray="3,2" RadiusX="6" RadiusY="6" />
          <ContentPresenter Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.dashed:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Small square icon button (remove area, "⋯" menu) -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Save while nothing changed or something is invalid: a plain raised button with faint text, not a dimmed amber one -->
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_Body">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Border.sep">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
  </Style>

  <!-- Loot grid editor place: 48 x 44 (52 wide with the margin), icon and code only (no count). Empty: dashed with a faint +. -->
  <Style Selector="Button.lootslot">
    <Setter Property="Height" Value="44" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="5" />
          <Rectangle Name="PART_Dashes" Stroke="{DynamicResource LineStrongBrush}" StrokeThickness="1" StrokeDashArray="3,2"
                     RadiusX="5" RadiusY="5" IsVisible="False" />
          <ContentPresenter Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.lootslot.empty /template/ Border#PART_Body">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.lootslot.empty /template/ Rectangle#PART_Dashes">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.lootslot:pointerover /template/ Border#PART_Body">
    <Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.lootslot:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Loot grid editor picker list item -->
  <Style Selector="Button.lootmatch">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.lootmatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
  </Style>
</Styles>
